#include <iostream>
#include <vector>
#include <fstream>
#include <clocale>
#include <queue>
#include <algorithm>

using namespace std;

// функция bfs, возвращающая кратчайший путь от start до end
// в виде вектора вершин (включая start и end) или пустой вектор, если пути нет
vector<int> shortestPathBFS(int start, int end, const vector<vector<int>>& Gr) {
    int n = Gr.size();
    vector<bool> visited(n, false);
    vector<int> parent(n, -1);   // для восстановления пути
    queue<int> q;

    visited[start] = true;
    q.push(start);

    while (!q.empty()) {
        int cur = q.front();
        q.pop();

        if (cur == end) break;   // дошли до конечной вершины

        for (int neighbor : Gr[cur]) { // перебираем всех соседей текущей вершины
            if (!visited[neighbor]) {
                visited[neighbor] = true; // помечаем как посещённого
                parent[neighbor] = cur;   // запоминаем, откуда пришли
                q.push(neighbor);
            }
        }
    }

    // если конечная вершина не достигнута, возвращаем пустой вектор
    if (!visited[end]) return {};

    // восстанавливаем путь от end до start (идём по parent)
    vector<int> path;
    for (int v = end; v != -1; v = parent[v]) {
        path.push_back(v);
    }
    reverse(path.begin(), path.end());   // переворачиваем, чтобы было от start до end
    return path;
}

int main() {
    setlocale(LC_ALL, "Russian");   

    int N, m;
    vector<vector<int>> Gr;
    int u, v;

    // читаем граф из файла 
    ifstream fin("Task8_1.txt");
    if (!fin) {
        cout << "не удалось открыть файл Task8_4.txt\n";
        return 1;
    }
    fin >> N >> m;
    Gr.resize(N);                     // динамическая структура: N списков

    // заполняем список смежности 
    for (int i = 0; i < m; i++) {
        fin >> u >> v;
        Gr[u].push_back(v);
        Gr[v].push_back(u);
    }
    fin.close();

    // выводим список смежности для наглядности
    cout << "\nсписок смежности графа:\n";
    for (int i = 0; i < N; i++) {
        cout << i << ": ";
        for (int neighbor : Gr[i]) {
            cout << neighbor << " ";
        }
        cout << endl;
    }

    // запрашиваем вершины A и B
    int A, B;
    cout << "\nвведите вершины A и B (через пробел, от 0 до " << N - 1 << "): ";
    cin >> A >> B;

    // проверка корректности ввода
    if (A < 0 || A >= N || B < 0 || B >= N) {
        cout << "неверные номера вершин\n";
        return 0;
    }

    // поиск кратчайшего пути
    vector<int> path = shortestPathBFS(A, B, Gr);

    // вывод результата
    cout << "\nрезультат:\n";
    if (path.empty()) {
        cout << "пути между " << A << " и " << B << " не существует (вершины в разных компонентах связности)\n";
    }
    else {
        cout << "кратчайший путь: ";
        for (size_t i = 0; i < path.size(); i++) {
            cout << path[i];
            if (i != path.size() - 1) cout << " -> ";
        }
        cout << "\nдлина пути (количество рёбер): " << path.size() - 1 << endl;
    }

    return 0;
}
